# Supabase (safe to expose on client — RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Anthropic — server-side only, never prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=sk-ant-...

# Claude model (optional — defaults to claude-sonnet-5)
CLAUDE_MODEL=claude-sonnet-5

# Support contacts — override emails without a code change (optional)
MEAL_SUPPORT_EMAIL=stephanie@example.com
SYSTEMS_SUPPORT_EMAIL=yousif.jawad@example.com
